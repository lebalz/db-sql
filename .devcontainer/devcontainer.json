{
  "name": "DB-SQL Monorepo",
  "dockerComposeFile": "compose.yaml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "16"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/rails/devcontainer/features/activestorage": {},
    "ghcr.io/rails/devcontainer/features/postgres-client": {
      "version": "17"
    },
    "ghcr.io/code-fabrik/features/dokku-cli:latest": {},
    "ghcr.io/georglauterbach/dev-container-features/cache-vscode-extensions:0": {}
  },
  "containerEnv": {
    "DB_HOST": "postgres",
    "SELENIUM_HOST": "selenium",
    "REDIS_URL": "redis://redis:6379/1"
  },
  "forwardPorts": [3000, 3035, 7900],
  "portsAttributes": {
    "3000": {
      "label": "Rails API"
    },
    "3035": {
      "label": "React Dev Server"
    },
    "7900": {
      "label": "Selenium VNC"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "shardulm94.trailing-spaces",
        "tomoki1207.pdf",
        "ms-ossdata.vscode-pgsql",
        "GitHub.copilot"
      ],
      "settings": {
        "rubyLsp.rubyVersionManager": {
          "identifier": "none"
        },
        "rubyLsp.formatter": "auto",
        "editor.formatOnSaveMode": "file",
        "pgsql.serverGroups": [
          {
            "name": "Servers",
            "id": "A36247BC-2F81-44CA-8371-3748FB5F3D29",
            "isDefault": true
          }
        ],
        "pgsql.connections": [
          {
            "id": "3C1C5DCB-B1E6-443D-B00B-19DF88705087",
            "groupId": "A36247BC-2F81-44CA-8371-3748FB5F3D29",
            "authenticationType": "SqlLogin",
            "connectTimeout": 15,
            "applicationName": "vscode-pgsql",
            "clientEncoding": "utf8",
            "sslmode": "disable",
            "server": "postgres",
            "user": "db_sql",
            "port": "5432",
            "database": "db_sql_development",
            "password": "db_sql",
            "savePassword": true,
            "profileName": "DB-SQL",
            "copilotAccessMode": "ro",
            "expiresOn": 0
          }
        ]
      }
    }
  },
  "postCreateCommand": "(cd backend && bin/setup --skip-server) && (cd frontend && yarn install)"
}
